<?xml version="1.0" encoding="UTF-8"?>
<interface domain="lan-mouse">
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="GtkAdjustment" id="sensitivity_adjustment">
    <property name="lower">0.1</property>
    <property name="upper">4</property>
    <property name="step-increment">0.1</property>
    <property name="value">1</property>
  </object>
  <object class="GtkAdjustment" id="port_adjustment">
    <property name="lower">1024</property>
    <property name="upper">65535</property>
    <property name="step-increment">1</property>
    <property name="value">4242</property>
  </object>
  <object class="GtkAdjustment" id="key_delay_adjustment">
    <property name="lower">100</property>
    <property name="upper">2000</property>
    <property name="step-increment">50</property>
    <property name="value">500</property>
  </object>
  <object class="GtkAdjustment" id="key_interval_adjustment">
    <property name="lower">10</property>
    <property name="upper">500</property>
    <property name="step-increment">5</property>
    <property name="value">32</property>
  </object>
  <object class="GtkStringList" id="language_model">
    <items>
      <item translatable="yes">System default</item>
      <item translatable="yes">English</item>
      <item>中文（简体）</item>
    </items>
  </object>
  <object class="GtkStringList" id="notification_model">
    <items>
      <item translatable="yes">In-app banner</item>
      <item translatable="yes">System notifications</item>
      <item translatable="yes">Banner and system notifications</item>
    </items>
  </object>
  <template class="SettingsWindow" parent="AdwPreferencesWindow">
    <property name="title" translatable="yes">Preferences</property>
    <property name="default-width">560</property>
    <property name="default-height">480</property>
    <child>
      <object class="AdwPreferencesPage">
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">General</property>
            <child>
              <object class="AdwComboRow" id="language_row">
                <property name="title" translatable="yes">Language</property>
                <property name="subtitle" translatable="yes">Restart Lan Mouse to apply</property>
                <property name="model">language_model</property>
              </object>
              <object class="AdwComboRow" id="notification_row">
                <property name="title" translatable="yes">Notifications</property>
                <property name="subtitle" translatable="yes">Where hints like &quot;clipboard shared&quot; are shown</property>
                <property name="model">notification_model</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Sharing</property>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Share clipboard</property>
                <property name="subtitle" translatable="yes">Send text and images you copy to connected devices</property>
                <property name="activatable-widget">clipboard_switch</property>
                <child type="suffix">
                  <object class="GtkSwitch" id="clipboard_switch">
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow" id="download_dir_row">
                <property name="title" translatable="yes">Download folder</property>
                <property name="subtitle">~/Downloads</property>
                <property name="activatable-widget">download_dir_button</property>
                <child type="suffix">
                  <object class="GtkButton" id="download_dir_button">
                    <property name="label" translatable="yes">Choose…</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Input</property>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Invert scrolling</property>
                <property name="subtitle" translatable="yes">Reverse the scroll direction on devices you control</property>
                <property name="activatable-widget">invert_scroll_switch</property>
                <child type="suffix">
                  <object class="GtkSwitch" id="invert_scroll_switch">
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Mouse sensitivity</property>
                <property name="subtitle" translatable="yes">Pointer speed multiplier applied on controlled devices</property>
                <property name="activatable-widget">sensitivity_spin</property>
                <child type="suffix">
                  <object class="GtkSpinButton" id="sensitivity_spin">
                    <property name="adjustment">sensitivity_adjustment</property>
                    <property name="digits">1</property>
                    <property name="valign">center</property>
                    <property name="width-chars">5</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Key repeat delay</property>
                <property name="subtitle" translatable="yes">Hold time before a key repeats, in ms — applied on Windows and macOS receivers</property>
                <property name="activatable-widget">key_delay_spin</property>
                <child type="suffix">
                  <object class="GtkSpinButton" id="key_delay_spin">
                    <property name="adjustment">key_delay_adjustment</property>
                    <property name="digits">0</property>
                    <property name="valign">center</property>
                    <property name="width-chars">6</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Repeat interval</property>
                <property name="subtitle" translatable="yes">Time between repeats once repeating, in ms — applied on Windows and macOS receivers</property>
                <property name="activatable-widget">key_interval_spin</property>
                <child type="suffix">
                  <object class="GtkSpinButton" id="key_interval_spin">
                    <property name="adjustment">key_interval_adjustment</property>
                    <property name="digits">0</property>
                    <property name="valign">center</property>
                    <property name="width-chars">6</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Connection</property>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Listen port</property>
                <property name="subtitle" translatable="yes">Port peers connect on — must match on every device</property>
                <property name="activatable-widget">port_spin</property>
                <child type="suffix">
                  <object class="GtkSpinButton" id="port_spin">
                    <property name="adjustment">port_adjustment</property>
                    <property name="digits">0</property>
                    <property name="valign">center</property>
                    <property name="width-chars">7</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Advanced</property>
            <property name="description" translatable="yes">key remapping and enter/release binds are configured in config.toml — restart Lan Mouse to apply</property>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">About</property>
            <child>
              <object class="AdwActionRow" id="version_row">
                <property name="title" translatable="yes">Version</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Website</property>
                <child type="suffix">
                  <object class="GtkLinkButton">
                    <property name="uri">https://github.com/lucgray/lan-mouse</property>
                    <property name="label">github.com/lucgray/lan-mouse</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Report an issue</property>
                <child type="suffix">
                  <object class="GtkLinkButton">
                    <property name="uri">https://github.com/lucgray/lan-mouse/issues</property>
                    <property name="label" translatable="yes">Issue tracker</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">License</property>
                <property name="subtitle">GPL-3.0-or-later</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
