<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>de.feschber.LanMouse</string>
	<!-- point this at the actual lan-mouse binary -->
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Lan Mouse.app/Contents/MacOS/lan-mouse</string>
		<string>daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/lan-mouse.out.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/lan-mouse.err.log</string>
</dict>
</plist>
